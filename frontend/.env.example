# Copy to .env.local for dev. All secrets in real environments are set via
# the hosting provider's env panel (Vercel), never committed.

# Postgres — local dev points at docker-compose.yml; prod points at the
# Supabase Session Pooler (port 5432, sslmode=require). Same DB the old Java
# backend used — schema already matches, no migrations run against it.
DATABASE_URL=postgres://portalrpg:portalrpg@localhost:5432/portalrpg

# false blocks new self-registration (only existing users can log in)
REGISTRATION_ENABLED=true

# HS256, must be >=32 bytes. Keep the SAME value used by the old Java backend
# in prod so already-issued tokens (and bcrypt password hashes) stay valid.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-abcdef-0123456789
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# echo (default) = deterministic mock, no LLM call. groq = real generation
# (OpenAI-compatible). gemini = Google Gemini.
#
# O retrieval manda muitos trechos por pergunta (RAG_TOP_K abaixo), então o provedor
# precisa aguentar um prompt grande. O Gemini é o que a app foi calibrada para usar.
#
# Medido no corebook V5 real (1121 chunks): uma pergunta de disciplina gera ~12,8 mil
# tokens de prompt com RAG_TOP_K=40, e ~3 a 7 mil com RAG_TOP_K=8. Contra os tetos
# gratuitos de cada provedor (consultados em ago/2026):
#
#   gemini-2.5-flash      250 mil tokens/min — cabe com folga, MAS só 20 req/dia
#   openai/gpt-oss-120b     8 mil tokens/min — exige RAG_TOP_K=8; 200 mil tokens/dia
#   groq/compound          70 mil tokens/min — cabe com RAG_TOP_K=40; 250 req/dia
#
# Ou seja: no gratuito o gargalo do Gemini é requisições/dia e o da Groq é tamanho do
# prompt. groq/compound é o único gratuito que aguenta o prompt cheio, mas é um sistema
# agêntico com busca na web embutida — o que conflita com o SYSTEM_PROMPT, que manda
# responder SÓ pelo trecho do livro. Não use sem verificar se a resposta continua ancorada.
AI_PROVIDER=echo
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Atenção: llama-3.1-8b-instant e llama-3.3-70b-versatile viraram Enterprise na Groq
# ("Contact Sales") — chave comum recebe 404. Use um modelo de disponibilidade geral.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ollama = modelo LOCAL (grátis, sem limite). Como o app roda em serverless (Vercel), o
# servidor precisa ALCANÇAR o Ollama: em produção, OLLAMA_BASE_URL é a URL de um túnel
# (cloudflared/ngrok) para a máquina com o Ollama ligado; em dev local, http://localhost:11434.
# num_ctx ALTO é obrigatório: o padrão do Ollama corta o prompt e apaga o trecho do livro.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_NUM_CTX=16384
# Só se o túnel exigir um header de acesso (Cloudflare Access, proxy com auth). Vazio = sem auth.
OLLAMA_API_KEY=

# Trechos do livro enviados ao gerador por pergunta. 40 cabe folgado no contexto do
# Gemini; em provedor com teto baixo de tokens/minuto, reduza (ex.: 8) para o prompt
# caber — menos trechos significam respostas menos completas, mas sem erro de limite.
RAG_TOP_K=40

# hashing (default) = deterministic lexical embedding, no network call.
# jina = semantic embedding via Jina API. Both dim 1024.
EMBEDDINGS_PROVIDER=hashing
JINA_BASE_URL=https://api.jina.ai/v1
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3

# Object storage for uploaded PDFs — mandatory in this rewrite (no local-disk
# fallback: serverless has no writable/persistent filesystem).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=rag-books

# Bootstrap admin (idempotent, only created if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
