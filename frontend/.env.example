# Copy to .env.local for dev. All secrets in real environments are set via
# the hosting provider's env panel (Vercel), never committed.

# Postgres — local dev points at docker-compose.yml; prod points at the
# Supabase Session Pooler (port 5432, sslmode=require). Same DB the old Java
# backend used — schema already matches, no migrations run against it.
DATABASE_URL=postgres://portalrpg:portalrpg@localhost:5432/portalrpg

# false blocks new self-registration (only existing users can log in)
REGISTRATION_ENABLED=true

# HS256, must be >=32 bytes. Keep the SAME value used by the old Java backend
# in prod so already-issued tokens (and bcrypt password hashes) stay valid.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-abcdef-0123456789
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# echo (default) = deterministic mock, no LLM call. groq = real generation
# (OpenAI-compatible). gemini = Google Gemini.
AI_PROVIDER=echo
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# hashing (default) = deterministic lexical embedding, no network call.
# jina = semantic embedding via Jina API. Both dim 1024.
EMBEDDINGS_PROVIDER=hashing
JINA_BASE_URL=https://api.jina.ai/v1
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3

# Object storage for uploaded PDFs — mandatory in this rewrite (no local-disk
# fallback: serverless has no writable/persistent filesystem).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=rag-books

# Bootstrap admin (idempotent, only created if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
